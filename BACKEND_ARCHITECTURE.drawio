    <diagram id="page4" name="4. Data Model (ER)">
        <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p4-user" value="&lt;b&gt;USER&lt;/b&gt;&lt;br&gt;_id: ObjectId&lt;br&gt;role: client|admin|superadmin|agent&lt;br&gt;email (unique, indexed)&lt;br&gt;password (hashed, select:false)&lt;br&gt;referredBy: referral code used at signup&lt;br&gt;status: activated|suspended" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
