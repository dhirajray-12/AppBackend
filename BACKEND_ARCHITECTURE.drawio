                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p6-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;jettySize=auto;" parent="1" source="p6-mark" target="p6-confirm" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
