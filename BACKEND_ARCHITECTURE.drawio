                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-r6" value="closed trades (mt5Account)" style="endArrow=none;startArrow=none;html=1;fontSize=10;strokeColor=#666666;" edge="1" parent="1" source="p4-account" target="p4-trade">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-r7" value="generates (one per upline level)" style="endArrow=none;startArrow=none;html=1;fontSize=10;strokeColor=#666666;" edge="1" parent="1" source="p4-trade" target="p4-comm">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p4-r8" value="receives (ibConfigurationId)" style="endArrow=none;startArrow=none;html=1;fontSize=10;strokeColor=#666666;" edge="1" parent="1" source="p4-ibcc" target="p4-comm">
