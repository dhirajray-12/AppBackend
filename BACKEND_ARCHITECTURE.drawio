                </mxCell>
                <mxCell id="p4-account" value="&lt;b&gt;ACCOUNT&lt;/b&gt;&lt;br&gt;user: ref User&lt;br&gt;mt5Account (unique)&lt;br&gt;groupName&lt;br&gt;managerIndex&lt;br&gt;balance&lt;br&gt;equity&lt;br&gt;investor_pwd / master_pwd&lt;br&gt;leverage, accountType, platform" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="280" y="250" width="260" height="178" as="geometry"/>
                </mxCell>
                <mxCell id="p4-ibcc" value="&lt;b&gt;IBCLIENTCONFIGURATION&lt;/b&gt;&lt;br&gt;userId: ref User&lt;br&gt;referralCode&lt;br&gt;parent: self-ref (upline)&lt;br&gt;level&lt;br&gt;IBbalance: withdrawable wallet&lt;br&gt;status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="940" y="250" width="280" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p4-group" value="&lt;b&gt;GROUP&lt;/b&gt;&lt;br&gt;name / groupName" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="280" y="500" width="220" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="p4-ibadmin" value="&lt;b&gt;IBADMINCONFIGURATION&lt;/b&gt;&lt;br&gt;groupId: ref Group&lt;br&gt;level (1-10)&lt;br&gt;bonusPerLot: flat rate, admin-set" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="560" y="500" width="260" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="p4-trade" value="&lt;b&gt;IBCLOSEDTRADE&lt;/b&gt;&lt;br&gt;positionId (unique)&lt;br&gt;mt5Account&lt;br&gt;volume&lt;br&gt;profit&lt;br&gt;commissionProcessed&lt;br&gt;processingClaimToken / WorkerId / ExpiresAt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="180" y="740" width="260" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p4-comm" value="&lt;b&gt;IBCOMMISSION&lt;/b&gt;&lt;br&gt;tradeId, clientId, ibUserId&lt;br&gt;ibConfigurationId&lt;br&gt;level&lt;br&gt;bonusPerLot, volume, commissionAmount&lt;br&gt;status: pending/confirmed/paid&lt;br&gt;batchId  (unique on tradeId+ibUserId+level)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="540" y="740" width="300" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="p4-with" value="&lt;b&gt;IBWITHDRAWAL&lt;/b&gt;&lt;br&gt;userId, ibConfigurationId&lt;br&gt;amount&lt;br&gt;status: pending/approved/rejected/completed" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="940" y="740" width="280" height="88" as="geometry"/>
