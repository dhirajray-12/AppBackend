    <diagram id="page6" name="6. Trade Sync Flow (tradeSyncService)">
        <mxGraphModel dx="1454" dy="571" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p6-start" value="setInterval tick&lt;br&gt;every TRADE_SYNC_INTERVAL_MS" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="40" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6-win" value="Pick sync window&lt;br&gt;(INITIAL_SETUP / REGULAR_SYNC / MANUAL_RANGE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="140" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-acc" value="Load active Accounts,&lt;br&gt;group by managerIndex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="250" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-fetch" value="Fetch GetCloseTradeAllUsers per manager,&lt;br&gt;in parallel (retry + 60s timeout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="360" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-filter" value="Keep only trades for&lt;br&gt;managed MT5 accounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="470" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6-dedupe" value="Dedupe by positionId,&lt;br&gt;bulkWrite insert new IBClosedTrade rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="570" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-claim" value="claimPendingCommissionTrades()&lt;br&gt;distributed-lock claim of ALL unprocessed trades" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="680" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-calc" value="calculateCommissionsBatch()&lt;br&gt;(see per-trade decision diagram)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="790" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-mark" value="Mark processed trades done;&lt;br&gt;release claims on trades needing retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="900" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p6-confirm" value="Flip batch&#39;s IBCommission docs&lt;br&gt;pending -&gt; confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="1010" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6-emit" value="Invalidate caches +&lt;br&gt;Socket.IO commission_updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="500" y="1110" width="380" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="p6-done" value="Sync cycle complete,&lt;br&gt;wait for next tick" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="500" y="1210" width="380" height="60" as="geometry"/>
                </mxCell>
