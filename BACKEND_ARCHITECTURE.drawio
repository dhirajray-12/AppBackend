    <diagram id="page18" name="18. Middlewares Reference (14 middlewares)">
        <mxGraphModel dx="1454" dy="571" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t1" value="middlewares/*  --  yellow rows = confirmed dead code (imported but never wired up)  --  note: 3 independent global process-error-handler sets exist (errorHandler.js, errorBoundary.js, globalErrorHandler.js)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="h2" value="Middleware" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#33507a;fontColor=#ffffff;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="40" width="200" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="h3" value="Purpose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#33507a;fontColor=#ffffff;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="240" y="40" width="380" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="h4" value="Applied" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#33507a;fontColor=#ffffff;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="620" y="40" width="320" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="h5" value="Behavior" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4a6fa5;strokeColor=#33507a;fontColor=#ffffff;fontStyle=1;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="40" width="520" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c6" value="auth.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="76" width="200" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="c7" value="Core JWT auth (protect) + role authorization (authorize) - resolves token, validates user, enforces billing-suspension lockout, validates device session, role-scoping." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="76" width="380" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="c8" value="Per-route; imported in 28+ route files as protect/authorize(...) guards" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="76" width="320" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="c9" value="Reads token from auth_token / auth_token_&lt;role&gt; cookie or Bearer header; infers role from URL prefix as fallback; runs User.findById + suspensionService.buildAccessPayload + DeviceSession lookup IN PARALLEL; 401 no token/session, 423 if suspended, 401 device mismatch/logged-out/expired, 403 blocked device or active-role mismatch; attaches req.user/req.deviceSession/req.suspensionState. authorize(...roles) -&gt; 403 on role mismatch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="76" width="520" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="c10" value="requestContext.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="160" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c11" value="AsyncLocalStorage per-request context tracker (requestId,url,method,ip,userAgent,userId,timing) for enriched error logs; trackError records via errorTracker." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="160" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c12" value="Globally in index.js - FIRST middleware registered (before CORS/helmet); trackError registered later after performanceMiddleware" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="160" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c13" value="Wraps request lifecycle in asyncLocalStorage.run(); sets X-Request-ID header; warns on requests &gt;1000ms. trackError sets X-Error-ID header then next(err), never sends a response itself" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="160" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c14" value="securityMiddleware.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="216" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c15" value="Bundle: rate limiter factory + authRateLimiter/apiRateLimiter presets, securityHeaders, sanitizeInput (basic XSS/script-tag stripping), ipWhitelist factory." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="216" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c16" value="securityHeaders + sanitizeInput ARE applied globally (after helmet). authRateLimiter/apiRateLimiter/ipWhitelist imported but NEVER .use()&#39;d anywhere - dead code" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="216" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c17" value="securityHeaders sets X-Content-Type-Options/X-Frame-Options/X-XSS-Protection/Referrer-Policy/Permissions-Policy, removes X-Powered-By. sanitizeInput strips &lt;script&gt; tags and javascript: URIs from req.body strings. Neither short-circuits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="216" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c18" value="performanceMiddleware.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="272" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c19" value="Request/response timing instrumentation (response-time based) + requestIdMiddleware for tracing." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="272" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c20" value="Globally in index.js, registered early (after CORS/helmet/securityHeaders/compression)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="272" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c21" value="Logs every API call when LOG_ALL_API_TIMINGS=true; always warns if slower than SLOW_REQUEST_THRESHOLD_MS (def 750ms); records into global.metrics.apiLatency. requestIdMiddleware reads/generates X-Request-ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="272" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c22" value="notificationMiddleware.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="328" width="200" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="c23" value="Attaches the shared notificationTriggers instance (created in socketServer.js) onto req.notificationTriggers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="328" width="380" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="c24" value="Globally in index.js - last middleware in setupMiddleware, after body-parsing/sanitization/static files" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="328" width="320" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="c25" value="Reads req.app.get(&#39;io&#39;); if io.notificationTriggers exists, sets req.notificationTriggers. Pure pass-through, never short-circuits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="328" width="520" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="c26" value="validationMiddleware.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="370" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c27" value="Generic Joi-schema validation factory (validate(schema,property)) + large &#39;schemas&#39; object for auth/deposit/withdrawal/transfer/IB endpoints." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="370" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c28" value="Per-route; confirmed in routes/authRoutes.js (signup/login/agentSignup); other schemas defined for controllers that may validate manually elsewhere" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="370" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c29" value="validate() runs schema.validate(req[property],{abortEarly:false}); on failure THROWS ValidationError (caught by errorHandler -&gt; 400 VALIDATION_ERROR); on success replaces req[property] with coerced value. Includes walletTypeSchema normalizer (usdt/tether/eth/tron/trx)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="370" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c30" value="pagination.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="426" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c31" value="Generic reusable pagination/filtering/search middleware factory paginate(model,options) + paginatedResponse helper." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="426" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c32" value="Per-route; confirmed in routes/admin/clientRoutes.js (though clientManagementController ignores its output and re-derives its own query - dead in that case)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="426" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c33" value="Parses page/limit, builds Mongo filter from filterFields/searchFields (regex $or), runs countDocuments, attaches req.pagination + req.queryOptions (skip/limit/sort). Never short-circuits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="426" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c34" value="errorHandler.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="482" width="200" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="c35" value="Primary centralized Express error handler + custom error-class hierarchy (AppError, ValidationError, AuthenticationError, AuthorizationError, NotFoundError, ConflictError, RateLimitError, DatabaseError, ExternalAPIError)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="482" width="380" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="c36" value="Registered globally via app.use(errorHandler), AFTER notFoundHandler, BEFORE globalErrorHandler - the primary 4-arg error handler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="482" width="320" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="c37" value="Generates errorId, logs full context via logger; branches: Mongoose ValidationError-&gt;400, dup key(11000)-&gt;409, CastError-&gt;400, JWT errors-&gt;401, Multer errors-&gt;400, Axios errors-&gt;502/upstream, AppError instances-&gt;own statusCode, RateLimitError-&gt;429, generic-&gt;500 (redacted in prod). Also exports duplicate asyncHandler + sanitizeRequestBody + its own uncaughtException/unhandledRejection listeners" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="482" width="520" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="c38" value="globalErrorHandler.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="566" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c39" value="Second &#39;catch everything&#39; error layer + crash.log writer + errorTracker integration + notFoundHandler for unmatched routes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="566" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c40" value="Registered globally, LAST of 3 chained error handlers (notFoundHandler -&gt; errorHandler -&gt; globalErrorHandler) - mostly a backstop since errorHandler responds first" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="566" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c41" value="notFoundHandler builds 404 AppError for unmatched routes. globalErrorHandler pulls AsyncLocalStorage context, tracks via errorTracker, returns JSON (stack outside prod or on 5xx). ALSO independently registers its own uncaughtException/unhandledRejection/warning listeners - 3rd redundant set alongside errorHandler.js and errorBoundary.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="566" width="520" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c42" value="errorBoundary.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="636" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c43" value="Provides asyncWrapper (async route wrapper w/ structured logging) and wsWrapper (try/catch for Socket.IO handlers); registers its own unhandledRejection logger." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="636" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c44" value="asyncWrapper imported in index.js but not observed applied to specific routes in setup; wsWrapper intended for socketServer.js handlers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="636" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c45" value="asyncWrapper catches rejection, logs method/url/error/stack/userId, then next(error). wsWrapper catches sync throws in socket handlers, logs, emits &#39;error&#39; event back to socket. unhandledRejection listener only logs, does not crash process" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="636" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c46" value="rateLimiter.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="692" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c47" value="Factory (createRateLimiter) producing 4 named limiters (auth 5/15min, api 100/15min, sensitive 10/hr, public 500/15min) throwing custom RateLimitError." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="692" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c48" value="Imported once in index.js but grep found NO .use() call wiring any of the 4 limiters onto the app or any route - DEAD CODE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="692" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c49" value="(As designed) windowMs/max/message configurable; keyGenerator prefers req.user.id over IP; handler throws RateLimitError rather than responding directly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="692" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c50" value="responseFormatter.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="748" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c51" value="Would attach standardized res.success()/res.error()/res.paginated() helpers for consistent API envelope shape." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="748" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c52" value="NOT applied anywhere - grep found no require() outside its own file - DEAD CODE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="748" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c53" value="(As designed) res.success(data,message,statusCode) / res.error(message,statusCode,errorCode) / res.paginated(data,pagination,message) each build a consistent {success,message,data,timestamp} envelope" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="748" width="520" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c54" value="upload.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="804" width="200" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c55" value="Hardened multer-based file-upload middleware (upload, enhancedUpload) with MIME/extension/magic-number validation, double-extension checks, sharp/pdf-parse deep validation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="804" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c56" value="NOT applied anywhere - grep confirms no route/controller requires it - DEAD CODE. Actual upload endpoints (paymentMethod/deposit/profile/ticket controllers) each build their own local multer config instead" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="804" width="320" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c57" value="(As designed) validates magic-number signature vs declared MIME, rejects double extensions/special chars in filenames, 10MB/10-file limit; enhancedUpload deletes file + 400s on failed sharp/pdf-parse validation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="804" width="520" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c58" value="asyncHandler.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="40" y="874" width="200" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c59" value="Simple higher-order wrapper catching rejected promises from async route handlers, forwarding to next()." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="240" y="874" width="380" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c60" value="Not applied globally; used ad hoc by individual controller/route files that import it directly (a functionally-identical copy also lives inside errorHandler.js)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="620" y="874" width="320" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c61" value="Wraps handler fn; on rejection calls next(error). No status codes of its own" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#cccccc;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" parent="1" vertex="1">
                    <mxGeometry x="940" y="874" width="520" height="56" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>